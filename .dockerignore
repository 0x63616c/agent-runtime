# Production images compile only reviewed runtime source. Deployment state,
# documentation, evidence, and generated local state cannot alter image bytes.
**
!go.mod
!go.sum
!cmd/
!cmd/runtime/
!cmd/runtime/**
!cmd/egress-proxy/
!cmd/egress-proxy/**
!cmd/agent-runtime-api/
!cmd/agent-runtime-api/**
!cmd/firecracker-direct-preflight/
!cmd/firecracker-direct-preflight/**
!cmd/firecracker-smoke/
!cmd/firecracker-smoke/**
!internal/
!internal/**
!sandbox/
!sandbox/**
!temporalpayload/
!temporalpayload/**
!sdk/
!sdk/**
!deploy/
!deploy/production/
!deploy/production/Dockerfile
!deploy/production/Dockerfile.direct-kvm-runner
!deploy/production/build-direct-kvm-runner-image.sh

# Deliberately excluded from the production image build context.
deploy/*
!deploy/production/Dockerfile
!deploy/production/Dockerfile.direct-kvm-runner
!deploy/production/build-direct-kvm-runner-image.sh
docs/
website/
evidence/
.runtime/
